#!/bin/bash
# Pre-commit hook for roguelike project
# Runs formatting, linting, and tests before allowing commit
#
# To install:
#   git config core.hooksPath .github/hooks
#
# To bypass temporarily:
#   git commit --no-verify

set -e  # Exit on first failure

# Skip checks if no Rust/TOML/workflow files are staged
if git diff --cached --name-only | grep -qE '\.(rs|toml|yml|yaml|lock)$'; then
    : # Build-relevant files staged — run full checks
else
    echo "No build-relevant files changed — skipping build checks."
    exit 0
fi

echo "Running pre-commit checks..."
echo ""

echo "→ Checking code formatting..."
cargo fmt --check
echo "✓ Format check passed"
echo ""

echo "→ Running clippy..."
cargo clippy -- -D warnings
echo "✓ Clippy passed"
echo ""

echo "→ Running tests..."
cargo test --quiet
echo "✓ Tests passed"
echo ""

echo "✅ All checks passed! Proceeding with commit."
